# =============================================================================
# Centralized version configuration for KC Token Exchange V2 Demo
#
# Change versions here — they propagate automatically to:
#   - docker-compose.yml          (Keycloak container image)
#   - Containerfile.app            (Java builder/runtime image)
#   - Containerfile.kc-spi         (Java builder + Keycloak runtime image)
#   - deploy-openshift.sh          (KC image + BuildConfig build args)
#   - openshift/buildconfigs.yaml  (build args → Containerfile ARGs)
#   - openshift/kc-*-deployment.yaml (Keycloak container image)
#
# After changing versions:
#   Local:     podman rm -f kc-a kc-b kc-c && ./start-keycloaks.sh
#   OpenShift: ./deploy-openshift.sh --mode provisioning
#
# NOTE: pom.xml properties must be updated manually to match:
#   <keycloak.version>   → KEYCLOAK_VERSION
#   <quarkus.platform.version> → QUARKUS_VERSION
#   <maven.compiler.release>   → JAVA_VERSION
# =============================================================================

# ---- Keycloak ----
KEYCLOAK_VERSION=26.5.3

# ---- Quarkus ----
QUARKUS_VERSION=3.20.3

# ---- Java ----
JAVA_VERSION=21
