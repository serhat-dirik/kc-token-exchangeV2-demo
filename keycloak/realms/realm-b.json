{
  "realm": "realm-b",
  "enabled": true,
  "displayName": "Realm B - Service Tier",
  "organizationsEnabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Regular user role"
      },
      {
        "name": "service-caller",
        "description": "Allowed to call downstream services"
      }
    ]
  },
  "defaultRoles": ["user"],
  "scopeMappings": [
    {
      "client": "app-a-m2m-client",
      "roles": ["user", "service-caller"]
    }
  ],
  "clients": [
    {
      "clientId": "app-b-client",
      "name": "App B Service Client (Bearer-only)",
      "enabled": true,
      "publicClient": false,
      "secret": "app-b-secret",
      "bearerOnly": false,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "app-a-m2m-client",
      "name": "App A M2M Client for JWT Grant",
      "description": "Confidential client used by App-A to perform RFC 7523 JWT Authorization Grant",
      "enabled": true,
      "publicClient": false,
      "secret": "app-a-m2m-secret",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "attributes": {
        "oauth2.jwt.authorization.grant.enabled": "true",
        "oauth2.jwt.authorization.grant.idp": "kc-a-idp"
      },
      "protocolMappers": [
        {
          "name": "realm-c-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "http://localhost:8380/realms/realm-c",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "kc-a-idp",
      "displayName": "Keycloak A (Upstream)",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "issuer": "http://localhost:8180/realms/realm-a",
        "authorizationUrl": "http://localhost:8180/realms/realm-a/protocol/openid-connect/auth",
        "tokenUrl": "http://localhost:8180/realms/realm-a/protocol/openid-connect/token",
        "jwksUrl": "http://host.containers.internal:8180/realms/realm-a/protocol/openid-connect/certs",
        "userInfoUrl": "http://host.containers.internal:8180/realms/realm-a/protocol/openid-connect/userinfo",
        "logoutUrl": "http://localhost:8180/realms/realm-a/protocol/openid-connect/logout",
        "clientId": "app-a-m2m-client",
        "clientSecret": "not-used-for-jwt-grant",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "syncMode": "FORCE",
        "hideOnLoginPage": "true",
        "jwtAuthorizationGrantEnabled": "true"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "username-mapper",
      "identityProviderAlias": "kc-a-idp",
      "identityProviderMapper": "oidc-username-idp-mapper",
      "config": {
        "template": "${ALIAS}.${CLAIM.preferred_username}",
        "syncMode": "INHERIT"
      }
    },
    {
      "name": "email-mapper",
      "identityProviderAlias": "kc-a-idp",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "email",
        "user.attribute": "email",
        "syncMode": "INHERIT"
      }
    },
    {
      "name": "first-name-mapper",
      "identityProviderAlias": "kc-a-idp",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "given_name",
        "user.attribute": "firstName",
        "syncMode": "INHERIT"
      }
    },
    {
      "name": "last-name-mapper",
      "identityProviderAlias": "kc-a-idp",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "family_name",
        "user.attribute": "lastName",
        "syncMode": "INHERIT"
      }
    },
    {
      "name": "origin-attribute-mapper",
      "identityProviderAlias": "kc-a-idp",
      "identityProviderMapper": "hardcoded-attribute-idp-mapper",
      "config": {
        "attribute": "origin",
        "attribute.value": "kc-a",
        "syncMode": "INHERIT"
      }
    }
  ]
}
